<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Internet aur Network Permissions (APIs ke liye) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 2. Background Video Rendering ki Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 3. Storage Permissions (Generated Video Gallery mein save karne ke liye) -->
    <!-- Android 12 aur usse purane phones ke liye -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 13 aur naye phones ke liye -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:label="RS Movie Spot"
        android:supportsRtl="true">
        
        <!-- MAIN APP UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VIDEO RENDER SERVICE -->
        <service
            android:name=".service.VideoRenderService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            
    </application>
</manifest>
